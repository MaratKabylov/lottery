VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-or-publishable-key
# Optional public Cloudflare key; pair with TURNSTILE_SECRET_KEY in Edge secrets.
VITE_TURNSTILE_SITE_KEY=
# Optional credentials for npm run test:integration, preferably in a test project.
# Existing Supabase Auth users must have matching admin/host profiles.
# Never prefix these credentials or a management access token with VITE_.
EVENTDRAW_TEST_ADMIN_EMAIL=
EVENTDRAW_TEST_ADMIN_PASSWORD=
EVENTDRAW_TEST_HOST_EMAIL=
EVENTDRAW_TEST_HOST_PASSWORD=
# Optional alternative to interactive `npm run supabase -- login`:
SUPABASE_ACCESS_TOKEN=
